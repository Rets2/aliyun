PORT=3000

# Huawei IoTDA OpenAPI config
HWCLOUD_REGION_ID=cn-east-3
# Optional custom northbound API endpoint (recommended for some cn-east-3 instances)
# Example: https://<instance-prefix>.st1.iotda-app.cn-east-3.myhuaweicloud.com
HWCLOUD_ENDPOINT=
HWCLOUD_PROJECT_ID=
HWCLOUD_AK=
HWCLOUD_SK=

# Target device/product
HWCLOUD_DEVICE_ID=
HWCLOUD_PRODUCT_ID=
HWCLOUD_SERVICE_ID=Rets2

# Optional for dedicated instance/app
HWCLOUD_INSTANCE_ID=
HWCLOUD_APP_ID=

# Online check & retry
TARGET_ONLINE_WAIT_MS=15000
TARGET_ONLINE_POLL_MS=1500
STRICT_TARGET_ONLINE_CHECK=false
CLOUD_DISPATCH_RETRY_ATTEMPTS=3
CLOUD_DISPATCH_RETRY_INTERVAL_MS=2000

# Property monitoring
PROPERTY_POLL_ON_CONNECT=true
PROPERTY_POLL_INTERVAL_MS=2000

# Auto connect on server start
AUTO_CONNECT_ON_START=true
