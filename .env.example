PORT=3000

# Device triplet
ALIYUN_PRODUCT_KEY=
ALIYUN_DEVICE_NAME=
ALIYUN_DEVICE_SECRET=

# Region, for example: cn-shanghai / cn-beijing / ap-southeast-1
ALIYUN_REGION_ID=cn-shanghai

# Optional custom clientId (without securemode fields)
ALIYUN_CLIENT_ID=

# Whether to open a local MQTT session in web backend.
# Keep false for real devices to avoid session conflict.
ENABLE_LOCAL_MQTT=false

# OpenAPI credentials for QueryThingModel
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Optional for enterprise instance
ALIYUN_IOT_INSTANCE_ID=

# Optional: allow cloud-route command fallback to raw MQTT when OpenAPI fails.
# Recommended false to avoid "publish success but device no response" for /sys topics.
ALLOW_CLOUD_ROUTE_MQTT_FALLBACK=false

# Wait/poll target online state before cloud dispatch
TARGET_ONLINE_WAIT_MS=15000
TARGET_ONLINE_POLL_MS=1500
STRICT_TARGET_ONLINE_CHECK=false
CLOUD_DISPATCH_RETRY_ATTEMPTS=3
CLOUD_DISPATCH_RETRY_INTERVAL_MS=2000

# Device property monitoring
PROPERTY_POLL_ON_CONNECT=true
PROPERTY_POLL_INTERVAL_MS=2000

# Auto connect on server start.
# For cloud deployment with dedicated backend triplet, set true so the page is ready immediately.
AUTO_CONNECT_ON_START=true
